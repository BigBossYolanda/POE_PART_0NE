import org.junit.jupiter.api.Test;

import java.lang.reflect.Method;

import static org.junit.jupiter.api.Assertions.*;

public class ChatTest {

    @Test
    void testGenerateMessageId() throws Exception {
        // Use reflection to access the private static method "generateMessageId"
        Method method = ChatTest.class.getDeclaredMethod("generateMessageId");
        method.setAccessible(true);

        // Invoke the method (no arguments since it's static and parameterless)
        String messageId = (String) method.invoke(null);

        // Verify that the generated ID is not null
        assertNotNull(messageId);
        // Verify that the generated ID starts with "MSG"
        assertTrue(messageId.startsWith("MSG"));
    }

    @Test
    void testGenerateMessageHash() throws Exception {

        Method method =ChatTest.class.getDeclaredMethod(
                "generateMessageHash",
                String.class,
                int.class,
                String.class
        );

        method.setAccessible(true);

        String result = (String) method.invoke(
                null,
                "MSG12345",// message ID
                1,               // sequence number
                "Hello world"    // message content
        );

        // Verify that the hash matches the expected format
        assertEquals("MS:1:HELLOWORLD", result);
    }

    @Test
    void testValidSouthAfricanNumber() {

        // Example of a valid South African mobile number format (+27 followed by 9 digits)
        String number = "+27812345678";

        boolean valid = number.matches("\\+27\\d{9}");

        assertTrue(valid);
    }

    @Test
    void testInvalidSouthAfricanNumber() {

        String number = "0812345678";

        boolean valid = number.matches("\\+27\\d{9}");

        assertFalse(valid);
    }

    @Test
    void testMessageLengthValid() {

        String message = "This is a short message";

        assertTrue(message.length() <= 250);
    }

    @Test
    void testMessageLengthTooLong() {

        String message = "A".repeat(251);

        assertTrue(message.length() > 250);
    }
